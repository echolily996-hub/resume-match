# Public local test credentials for development and acceptance testing; not production secrets.
POSTGRES_DB=resume_match
POSTGRES_USER=resume_app
POSTGRES_PASSWORD=local_test_db_password
WEB_PORT=8080
APP_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080
COOKIE_SECURE=false
SESSION_HOURS=12
SEED_USER_A=demo_a
SEED_PASSWORD_A=Demo-A-2026!
SEED_USER_B=demo_b
SEED_PASSWORD_B=Demo-B-2026!
# Analysis requires a real OpenAI-compatible model server configuration.
# Keep MODEL_API_KEY empty in this example; set the real value only in local .env.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_RESPONSE_MODE=json_schema
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_OUTPUT_TOKENS=4000
ANALYSIS_WORKER_ENABLED=true
